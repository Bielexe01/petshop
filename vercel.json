{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "server/index.ts": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/server/index.ts"
    },
    {
      "source": "/((?!api/|_next/|assets/|photos/).*)",
      "destination": "/server/index.ts"
    }
  ]
}
