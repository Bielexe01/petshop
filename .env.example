# Porta do servidor (dev + preview)
PORT=5173

# Ambiente: development | production
NODE_ENV=development

# ────────────────────────────────────────────────────────────────────────
# Supabase (Postgres + Storage)
# No painel do Supabase: Project Settings → Database → Connection string.
# IMPORTANTE: use o POOLER (aws-0-<regiao>.pooler.supabase.com), NÃO o host
# legado db.<ref>.supabase.co — o host legado resolve apenas IPv6 e a
# Vercel (IPv4) não conecta (getaddrinfo ENOTFOUND → 500 em tudo).
# Usuário no pooler: postgres.<ref> (com o ponto). Porta 5432 = session pooler.
#   ex.: postgresql://postgres.<ref>:<password>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# URL do projeto Supabase (Project Settings → API). IMPORTANTE: é a URL base
# do projeto, SEM o sufixo /rest/v1/. Ex.:
#   https://<ref>.supabase.co
SUPABASE_URL=https://<ref>.supabase.co

# Service role key (Project Settings → API → service_role, SECRET). Só o
# servidor usa (nunca expor ao frontend).
SUPABASE_SERVICE_ROLE_KEY=<service-role-key-do-supabase>
