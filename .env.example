# Porta do servidor (dev + preview)
PORT=5173

# Ambiente: development | production
NODE_ENV=development

# ────────────────────────────────────────────────────────────────────────
# Supabase (Postgres + Storage)
# No painel do Supabase: Project Settings → Database → Connection string.
# Prefira a "URI" (com pooler) que inclui senha, ex.:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres

# URL do projeto Supabase (Project Settings → API). IMPORTANTE: é a URL base
# do projeto, SEM o sufixo /rest/v1/. Ex.:
#   https://<ref>.supabase.co
SUPABASE_URL=https://<ref>.supabase.co

# Service role key (Project Settings → API → service_role, SECRET). Só o
# servidor usa (nunca expor ao frontend).
SUPABASE_SERVICE_ROLE_KEY=<service-role-key-do-supabase>
